# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_platform_db
DB_CONNECTION_LIMIT=20

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_lowcode_platform_phase1_2026_xyz987
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_lowcode_platform_phase1_2026_abc123
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage Configuration (Stores files OUTSIDE code repo)
# In development, defaults to relative ../storage_data or an absolute path
MEDIA_STORAGE_PATH=../storage_data
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/svg+xml,image/x-icon,application/pdf

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
